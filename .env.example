# ---------------------------------------------------------------------------
# Draken SEO Suite - configuration
# Copy to .env and edit. Everything has a working default except the API keys.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
DRAKEN_ENV=development
DRAKEN_SECRET_KEY=change-me-to-a-long-random-string
DRAKEN_HOST=127.0.0.1
DRAKEN_PORT=8000

# SQLite by default (zero setup). For Postgres:
# DRAKEN_DATABASE_URL=postgresql+psycopg://draken:pass@localhost:5432/draken
DRAKEN_DATABASE_URL=sqlite:///./data/draken.db

# --- Single-user auth (dashboard login) -----------------------------------
DRAKEN_AUTH_ENABLED=true
DRAKEN_ADMIN_USER=admin
# Generated with: python -m draken.cli.main hash-password "yourpassword"
DRAKEN_ADMIN_PASSWORD_HASH=

# --- Crawler / network etiquette ------------------------------------------
DRAKEN_USER_AGENT=DrakenSEO/0.1 (+https://example.com/bot)
DRAKEN_RESPECT_ROBOTS=true
DRAKEN_CRAWL_CONCURRENCY=5
DRAKEN_CRAWL_DELAY_SECONDS=0.5
DRAKEN_REQUEST_TIMEOUT=20
DRAKEN_MAX_PAGES_PER_AUDIT=500

# --- Keyword / SERP data providers ---------------------------------------
# Free suggest endpoints are used when no paid provider is configured.
DRAKEN_SUGGEST_PROVIDERS=google,bing,duckduckgo
# Optional paid SERP provider for precise ranking data
DRAKEN_SERPAPI_KEY=
DRAKEN_DATAFORSEO_LOGIN=
DRAKEN_DATAFORSEO_PASSWORD=

# --- Backlink data providers (optional; internal index works without) -----
DRAKEN_COMMONCRAWL_ENABLED=true
DRAKEN_OPENPAGERANK_KEY=

# --- AI visibility (GEO) engines -----------------------------------------
# Add whichever you have. The module degrades gracefully per-engine.
DRAKEN_ANTHROPIC_API_KEY=
DRAKEN_ANTHROPIC_MODEL=claude-sonnet-5
DRAKEN_OPENAI_API_KEY=
DRAKEN_OPENAI_MODEL=gpt-4o
DRAKEN_PERPLEXITY_API_KEY=
DRAKEN_GEMINI_API_KEY=

# --- Outreach email (optional) -------------------------------------------
DRAKEN_SMTP_HOST=
DRAKEN_SMTP_PORT=587
DRAKEN_SMTP_USER=
DRAKEN_SMTP_PASSWORD=
DRAKEN_SMTP_FROM=
# Safety: nothing is ever emailed unless this is explicitly true
DRAKEN_OUTREACH_SEND_ENABLED=false

# --- Submission engine safety rails --------------------------------------
# Dry-run means submissions are prepared and logged but never POSTed.
DRAKEN_SUBMISSIONS_DRY_RUN=true
DRAKEN_SUBMISSIONS_REQUIRE_APPROVAL=true
DRAKEN_SUBMISSIONS_PER_DOMAIN_DAILY_CAP=1
DRAKEN_SUBMISSIONS_GLOBAL_DAILY_CAP=25
